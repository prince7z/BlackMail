{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blackmaill.vercel.app"
        }
      ],
      "destination": "https://blackmail.pcodes.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "blackmail.vercel.app"
        }
      ],
      "destination": "https://blackmail.pcodes.tech/:path*",
      "permanent": true
    }
  ]
}
